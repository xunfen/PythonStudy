num_list1 = []
#方式1：传统方法
for i in range(1, 21):
    num_list1.append(i ** 2)
print(num_list1)

#方式2：列表推导式:按照一定的规则快速生成一个列表的方法，格式：要插入的元素 元素的规则
num_list2 = [i ** 2 for i in range(1, 21)]
print(num_list2)


#提取偶数并在此平方
num_list3 = []
for i in num_list2 :
    if i % 2 == 0:
        num_list3.append(i ** 2)

print(num_list3)